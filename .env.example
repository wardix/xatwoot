# Xatwoot Environment Configuration
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://xatwoot:xatwootpassword@localhost:5432/xatwoot_db
JWT_SECRET=super_secret_jwt_key_change_in_production

# Storage Adapter (local | s3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:3000/uploads

# S3 / MinIO (required when STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=xatwoot-attachments
S3_ENDPOINT=
S3_PUBLIC_URL=

# Twilio / WhatsApp (required for VS-OMNICHANNEL-001)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+14155238886

# Meta / Facebook Messenger (required for VS-OMNICHANNEL-001)
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=xatwoot_meta_verify
